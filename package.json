{
  "name": "henna-art-by-arafa",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Henna Art by Arafa — static site, no build step required.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs 8080",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "node tools/lint.mjs",
    "check": "npm run lint && npm test",
    "build:images": "bash tools/build-images.sh",
    "build:video": "python3 tools/make_hero_video.py"
  },
  "engines": { "node": ">=18" }
}
